---
import '@fontsource/anton/latin-400.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '../styles/global.css';
import '../styles/reading-tools.css';
import ReadingTools from '../components/ReadingTools.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/urls';
import { siteConfig } from '../config/site';
import { photos } from '../lib/photos';
import NativeImageTransitions from '../components/NativeImageTransitions.astro';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; noindex?: boolean; edition?: 'engraved' | 'atelier' | 'experiments'; }
const { title, description = siteConfig.description, image = 'tampa-palms', type = 'website', noindex = false, edition } = Astro.props;
const fullTitle = title ? `${title} — Tampa Curated` : 'Tampa Curated — An independent eye on the city';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(photos[image]?.src || url('favicon.svg'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <script is:inline>
      try {
        if (localStorage.getItem('tc-reading-size') === 'original') document.documentElement.dataset.readingSize = 'original';
      } catch { /* Comfortable typography also works without storage or JavaScript. */ }
    </script>
    <NativeImageTransitions/>
    <title>{fullTitle}</title><meta name="description" content={description}/><meta name="theme-color" content="#e9ddc7"/>
    <link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href={url('favicon.svg')}/>
    <link rel="sitemap" href={url('sitemap-index.xml')}/>
    {noindex && <meta name="robots" content="noindex, follow"/>}
    <meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:type" content={type}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:site_name" content="Tampa Curated"/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImage}/>
  </head>
  <body class={edition === 'atelier' ? 'engraved atelier' : edition} style={`--paper-texture: url('${url('paper.svg')}'); --ink-texture: url('${url('ink.svg')}')`}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page-shell"><Header/><main id="main"><slot/></main><Footer/></div>
    <ReadingTools/>
  </body>
</html>
