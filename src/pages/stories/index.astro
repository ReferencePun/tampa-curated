---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePlate from '../../components/archive/ArchivePlate.astro';
import ArchiveInstrument from '../../components/archive/ArchiveInstrument.astro';
import {url} from '../../lib/urls';
import '../../styles/particle-archive.css';
const stories=(await getCollection('stories')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout edition="archive" title="Stories — The particle archive" description="Six photographic studies of Tampa. Move through ink, grain, and the stories beneath.">
 <div class="particle-archive" data-particle-archive data-archive-mode="still">
  <header class="archive-intro">
   <div><span class="archive-kicker">03 / STORIES &nbsp; — &nbsp; A PHOTOGRAPHIC ARCHIVE</span><h1>Nothing <em>stays still.</em></h1><p class="archive-subtitle">Not a city. Not a story. Not even the ink.</p></div>
   <div class="archive-intro-aside"><ArchiveInstrument/><p>A few things worth looking at.<br/>A little longer. A little closer.</p><span>VOLUME 001 &nbsp; / &nbsp; TAMPA, FLORIDA</span></div>
  </header>
  <div class="archive-tools">
   <p data-archive-instruction>Six studies. Follow a photograph into its story.</p>
   <div data-archive-controls hidden>
    <details class="archive-brush"><summary>Adjust the reveal <span aria-hidden="true">+</span></summary><div><label>Reach <input data-archive-radius type="range" min="75" max="230" value="90"/><output data-radius-value>90</output></label><label>Softness <input data-archive-falloff type="range" min="30" max="90" value="68"/><output data-falloff-value>68</output></label></div></details>
    <button type="button" data-archive-mode-toggle aria-pressed="false">Show photographs</button>
   </div>
  </div>
  <section class="archive-composition" aria-label="All stories">
   <div class="archive-construction" aria-hidden="true"><span>PLATE / 001—006</span><svg viewBox="0 0 1200 2000" preserveAspectRatio="none"><path d="M30 20H1165M850 80V390L620 540V740M70 860H350V1150H1050M1080 1390H680V1610H130M620 540l-7-7m7 7 7-7M350 1150l-7-7m7 7 7-7"/><circle cx="850" cy="390" r="4"/><circle cx="350" cy="1150" r="4"/><path d="M15 10v20M1180 10v20M70 850v20M1080 1380v20"/></svg></div>
   {stories.map((entry,index)=><ArchivePlate entry={entry} index={index}/>)}
   <aside class="archive-margin-note" aria-hidden="true"><span>look again.</span><svg viewBox="0 0 190 80"><path d="M8 12c40 2 54 57 142 43M150 55l-14-8m14 8-13 8"/></svg><small>THE IMAGE IS ONLY<br/>THE BEGINNING.</small></aside>
  </section>
  <footer class="archive-colophon"><span>THE ARCHIVE REMAINS OPEN.</span><p>Six sample essays from our first edition. A collection of perspectives, not verified reporting.</p><a href={url('credits/')}>Photography &amp; credits <span aria-hidden="true">↗</span></a></footer>
  <p class="sr-only" data-archive-status role="status" aria-live="polite"></p>
 </div>
</BaseLayout>
<script>import '../../scripts/archive/index';</script>
