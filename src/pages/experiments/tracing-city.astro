---
import {Image} from 'astro:assets';
import ExperimentLayout from '../../layouts/ExperimentLayout.astro';
import SaveButton from '../../components/experiments/SaveButton.astro';
import TracingArtwork from '../../components/experiments/TracingArtwork.astro';
import '../../styles/tracing-city.css';
import archive from '../../assets/archive/tampa-sanborn-1887-sheet1.jpg';
import {url} from '../../lib/urls';
const observations=[
 {id:'blocks',n:'01',title:'A city measured in blocks.',text:'On this 1887 sheet, the courthouse occupies a large block facing Madison. The drawing records footprints, materials, and the spaces between buildings.',after:'Our tracing picks out a few of those shapes. Slide it aside and return to the evidence underneath.',link:'neighborhoods/downtown/',label:'Read the Downtown guide',save:'neighborhoods:downtown',saveTitle:'Downtown'},
 {id:'water',n:'02',title:'Water has a way through.',text:'Look along Jackson Street on the original sheet: a narrow blue creek crosses the plan. In the index at the upper right, the Hillsborough River gives the street grid its edge.',after:'A reminder to read the water as carefully as the buildings.',link:'stories/the-city-now/',label:'Read The city now',save:'stories:the-city-now',saveTitle:'The city now'},
 {id:'index',n:'03',title:'A map inside a map.',text:'The small index at the upper right puts the detailed sheets back into a larger street pattern. Its numbered areas tell the reader where to look next.',after:'A paper navigation system, made visible again.',link:'neighborhoods/',label:'Explore today’s guides',save:'neighborhoods:downtown',saveTitle:'Downtown'},
];
---
<ExperimentLayout active="tracing-city" title="The city, in layers" description="Scroll through a drawing of Tampa's 1887 Sanborn map. Ink traces the streets, then the sleeve slides aside to reveal the archive underneath.">
<header class="lab-intro"><div><span class="lab-kicker">EXPERIMENT 02 / THE TRACING TABLE</span><h1>The city<br/> <em>leaves a trace.</em></h1></div><p>A real sheet from June 1887.<br/> A new drawing over the top.<br/> <span>Scroll. The ink finds its way.<br/> Then the sleeve slides away.</span></p></header>
<section class="tracing-journey" data-tracing-journey data-tracing-mode="still" aria-label="A drawing of Tampa, drawn and revealed with your scroll">
 <div class="tracing-scroll-track" data-tracing-track id="tracing-map">
  <div class="tracing-stage" data-tracing-stage>
   <header class="tracing-stage-top"><span>TC / A CITY IN LAYERS</span><a href="#tracing-notes">Skip to the field notes ↘</a></header>
   <div class="tracing-stage-layout">
    <figure class="tracing-figure">
     <div class="tracing-board" data-tracing-board>
      <Image src={archive} alt="Sheet 1 of the June 1887 Sanborn map of Tampa, with building footprints, streets, a creek, and an index" width={1613} format="webp" quality={86} loading="eager" class="archive-map"/>
      <svg class="tracing-sheet" data-tracing-sheet viewBox="0 0 1613 1913" fill="none" aria-hidden="true">
       <defs>
        <g id="tracing-artwork"><TracingArtwork/></g>
       </defs>
       <g>
        <use href="#tracing-artwork" opacity=".75"/>
        <text x="145" y="86" fill="#97513b" font-size="20" font-family="Georgia,serif" font-style="italic">a city, reconsidered / 1887</text>
       </g>
      </svg>
     </div>
    </figure>
    <div class="tracing-narrative">
     <span class="lab-kicker" data-tracing-chapter>AN ARCHIVE / AN INTERPRETATION</span>
     <h2 data-tracing-heading>A city,<br/><em>in layers.</em></h2>
     <p data-tracing-copy>Streets, water, and the spaces in between. Our drawing follows a few of the marks left on this 1887 sheet.</p>
     <span class="tracing-scroll-cue" data-tracing-cue hidden>SCROLL TO DRAW ↓</span>
     <div class="tracing-sequence-key" aria-hidden="true"><span data-trace-step="0">01 / INK</span><span data-trace-step="1">02 / PAPER</span><span data-trace-step="2">03 / ARCHIVE</span></div>
    </div>
   </div>
   <footer class="tracing-stage-bottom"><span>SANBORN / TAMPA / JUNE 1887</span><span data-tracing-direction hidden>Draw forward. Scroll back to retrace.</span></footer>
   <div class="tracing-progress" aria-hidden="true"><span></span></div>
  </div>
 </div>
 <figure class="tracing-still-original"><span class="lab-kicker">THE ORIGINAL SHEET</span><Image src={archive} alt="The original 1887 Sanborn map of Tampa, unobstructed by tracing paper" width={1000} format="webp" quality={86} loading="lazy"/></figure>
 <p class="tracing-credit">Sanborn Map Company, June 1887, sheet 1. <a href="https://www.loc.gov/item/sanborn01352_002/" target="_blank" rel="noreferrer">Library of Congress, Geography and Map Division, Sanborn Maps Collection ↗</a>. Public domain. <a href={archive.src} target="_blank">View the full original sheet ↗</a></p>
</section>
<section class="tracing-notes" id="tracing-notes" aria-labelledby="tracing-notes-title">
 <header><span class="lab-kicker">WHAT THE DRAWING LEAVES BEHIND</span><h2 id="tracing-notes-title">A few things<br/><em>worth noticing.</em></h2><p>An interpretive drawing of a historical sheet. These are observations, not a present-day street map.</p></header>
 <div class="trace-observations">{observations.map(o=><article data-observation={o.id} id={`observation-${o.id}`}><span class="lab-kicker">OBSERVATION / {o.n}</span><h3>{o.title}</h3><p>{o.text}</p><p>{o.after}</p><a class="lab-link" href={url(o.link)}>{o.label} ↗</a><SaveButton id={o.save} title={o.saveTitle}/></article>)}</div>
</section>
<div class="lab-colophon"><span>THE ORIGINAL REMAINS.</span><p>Each new layer is a way of looking, with its own marks and omissions. The city beneath is still there.</p><a href={url('experiments/notebook/')}>Next: keep a few things ↗</a></div>
</ExperimentLayout>
<script>import '../../scripts/experiments/tracing-city';</script>
