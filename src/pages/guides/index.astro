---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import EditionNavigation from '../../components/EditionNavigation.astro';
import Photo from '../../components/Photo.astro';
import { readingGuides } from '../../config/reading';
import { url } from '../../lib/urls';
import '../../styles/reading.css';
---
<BaseLayout title="Reading guides" description="Three paths through Tampa Curated: take a first look at the city, read after dark, or follow independent minds through the demonstration edition.">
  <EditionNavigation/>
  <PageIntro number="READING GUIDES" title="FOLLOW YOUR CURIOSITY" deck="Start with a mood. Follow an idea. Three different ways into the same city."/>
  <p class="collection-note">Reading routes through our demonstration edition, not verified travel itineraries. Each guide connects three existing stories, profiles, or neighborhood introductions.</p>
  <div class="reading-guide-index">{readingGuides.map((guide,i) => <article class={`reading-guide-row theme-${guide.theme}`}><span class="guide-large-number" aria-hidden="true">{guide.number}</span><div class="guide-row-copy"><span class="eyebrow">READING ROUTE {guide.number} / THREE CHAPTERS</span><h2><a href={url(`guides/${guide.slug}/`)}>{guide.title}</a></h2><p>{guide.deck}</p><a class="text-link" href={url(`guides/${guide.slug}/`)}>Follow this thread <span aria-hidden="true">↗</span></a></div><figure><Photo name={guide.image} alt={guide.imageAlt} treatment={guide.treatment} eager={i===0} sizes="(max-width: 700px) 90vw, 32vw"/>{guide.slug==='creative-tampa' && <figcaption class="reading-note">Illustrative stock portrait; not a named profile subject.</figcaption>}</figure></article>)}</div>
  <div class="reading-bottom"><p>Prefer to choose your own path?<br/><em>The whole edition is yours to explore.</em></p><a class="text-link" href={url('issues/001/')}>Browse the contents <span aria-hidden="true">⟶</span></a></div>
</BaseLayout>
