---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import SaveButton from '../../components/experiments/SaveButton.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Photo from '../../components/Photo.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import { url } from '../../lib/urls';
export async function getStaticPaths(){return (await getCollection('neighborhoods')).map(entry=>({params:{slug:entry.id},props:{entry}}));}
interface Props{entry:CollectionEntry<'neighborhoods'>}
const {entry}=Astro.props;const d=entry.data;const {Content}=await render(entry);const places=(await getCollection('businesses')).filter(p=>p.data.neighborhood.id===entry.id);const stories=(await getCollection('stories')).filter(s=>s.data.neighborhood.id===entry.id);
---
<BaseLayout title={d.title} description={d.deck} image={d.image}><nav class="breadcrumb" aria-label="Breadcrumb"><a href={url()}>Home</a><span>/</span><a href={url('neighborhoods/')}>Neighborhoods</a><span>/ {d.title}</span></nav><article><header class="detail-header"><span class="eyebrow">THE TAMPA GUIDE / {d.character}</span><h1>{d.title}</h1><p class="detail-deck">{d.deck}</p></header><figure class="detail-figure"><Photo sharedKey={`guide-${entry.id}`} name={d.image} alt={d.imageAlt} treatment={d.treatment} eager sizes="(max-width: 1250px) 95vw, 1200px"/><figcaption>{d.imageAlt}. <a href={url('credits/')}>Credits ↗</a></figcaption></figure><div class="article-body"><aside><SaveButton id={`neighborhoods:${entry.id}`} title={d.title}/>{d.demo && <DemoNotice kind="neighborhood"/>}<a class="text-link" href={`${url('the-list/')}?neighborhood=${entry.id}`}>Browse this neighborhood <span aria-hidden="true">↗</span></a></aside><div class="prose"><Content/></div></div></article><section class="detail-related"><SectionHeading label="Places in this neighborhood"/><p class="collection-note">Fictional demonstration entries, ready for real editorial recommendations.</p><div class="places-grid">{places.map(p=><PlaceCard entry={p} neighborhood={d.title}/>)}</div></section>{stories.length>0 && <section class="detail-related"><SectionHeading label="Stories from here"/><div class="stories-grid">{stories.map(s=><StoryCard entry={s}/>)}</div></section>}</BaseLayout>
