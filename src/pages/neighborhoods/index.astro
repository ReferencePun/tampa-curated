---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import NeighborhoodCard from '../../components/NeighborhoodCard.astro';
import Newsletter from '../../components/Newsletter.astro';
const neighborhoods=(await getCollection('neighborhoods')).sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Neighborhoods" description="Six Tampa neighborhoods, six ways to see the city. Explore our sample neighborhood guides."><PageIntro number="04" title="FIND YOUR TAMPA" deck="Take a different turn. Stay a little longer. There’s more here than you think."/><p class="collection-note">Real neighborhoods, sample guides. Associated businesses are fictional examples. Photographs are labeled where they are illustrative.</p><section class="neighborhood-grid neighborhood-archive" aria-label="All neighborhoods">{neighborhoods.map((entry,index)=><NeighborhoodCard entry={entry} index={index}/>)}</section><Newsletter/></BaseLayout>
