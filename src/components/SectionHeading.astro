---
interface Props { label: string; href?: string; linkLabel?: string; number?: string; }
const { label, href, linkLabel = 'View all', number } = Astro.props;
---
<div class="section-heading"><h2>{number && <span>{number} / </span>}{label}</h2><span class="heading-rule" aria-hidden="true"></span>{href && <a href={href}>{linkLabel}<span aria-hidden="true">⟶</span></a>}</div>
