---
import {beltPath} from '../../lib/mechanisms';
interface Props {x1:number;y1:number;r1:number;x2:number;y2:number;r2:number;rate?:number;crossed?:boolean;class?:string;}
const {x1,y1,r1,x2,y2,r2,rate=1,crossed=false,class:className=''}=Astro.props;
const belt=beltPath(x1,y1,r1,x2,y2,r2,crossed);
---
<g class:list={['pulley-system',className]}>
  <path d={belt} stroke-width="3" stroke="var(--paper)"/>
  <path d={belt} stroke-width=".8"/>
  <path d={belt} class="belt-marks" data-belt data-rate={rate*r1*Math.PI/180} stroke-dasharray="1 8" stroke-width="2.6"/>
  {[[x1,y1,r1,rate],[x2,y2,r2,rate*r1/r2*(crossed?-1:1)]].map(([x,y,r,speed])=><g transform={`translate(${x} ${y})`}>
    <circle r={r-3} fill="var(--paper)"/><circle r={r-6}/><circle r={r+3}/>
    <g data-gear data-rate={speed} data-phase="0" data-pulley-radius={r}>
      <path d={`M${-r+8} 0H${r-8}M0 ${-r+8}V${r-8}`} class="gear-spoke"/>
      <circle r={r*.22} fill="var(--paper)"/><circle r="3"/>
    </g>
  </g>)}
</g>
