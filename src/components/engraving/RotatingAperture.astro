---
import MechanicalImageFrame from './MechanicalImageFrame.astro';
interface Props { id:string;x:number;y:number;radius:number;photo:string;eager?:boolean; }
const {id,x,y,radius:r,photo,eager=false}=Astro.props;
---
<g transform={`translate(${x} ${y})`} data-aperture data-radius={r}>
  <MechanicalImageFrame id={`${id}-photo`} photo={photo} x={-r} y={-r} width={r*2} height={r*2} circle eager={eager}/>
  <defs><mask id={`${id}-iris`} maskUnits="userSpaceOnUse" x={-r-1} y={-r-1} width={r*2+2} height={r*2+2}><circle r={r+1} fill="white"/><circle data-iris-hole r={r*.96} fill="black"/></mask></defs>
  <g mask={`url(#${id}-iris)`}>
    <circle r={r} fill="var(--paper)"/>
    {Array.from({length:8},(_,i)=><g transform={`rotate(${i*45})`}><g data-iris-blade><path d={`M0 0Q${-r*.25} ${-r*.55} 0 ${-r}A${r} ${r} 0 0 1 ${r*.707} ${-r*.707}Q${r*.1} ${-r*.35} 0 0Z`} fill={i%2?'url(#tc-hatch)':'var(--paper-light)'}/></g></g>)}
  </g>
  <circle data-iris-rim r={r*.96} stroke-width="1.4"/>
</g>
