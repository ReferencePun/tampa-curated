---
// Short barbs follow the actual curve of each feather, with fixed pen variation.
type Point = [number, number];
function barbs(points: Point[], count: number, width: number) {
  const [a,b,c,d]=points;
  return Array.from({length:count},(_,i)=>{
    const t=(i+1)/(count+1),s=1-t;
    const x=s*s*s*a[0]+3*s*s*t*b[0]+3*s*t*t*c[0]+t*t*t*d[0];
    const y=s*s*s*a[1]+3*s*s*t*b[1]+3*s*t*t*c[1]+t*t*t*d[1];
    const dx=3*s*s*(b[0]-a[0])+6*s*t*(c[0]-b[0])+3*t*t*(d[0]-c[0]);
    const dy=3*s*s*(b[1]-a[1])+6*s*t*(c[1]-b[1])+3*t*t*(d[1]-c[1]);
    const l=Math.hypot(dx,dy),nx=-dy/l,ny=dx/l,tx=dx/l,ty=dy/l;
    const w=width*(.6+.4*Math.sin(t*Math.PI))*(1+.1*Math.sin(i*3));
    const p=(u:number,v:number)=>`${u.toFixed(1)} ${v.toFixed(1)}`;
    return `M${p(x+nx*w-tx*4,y+ny*w-ty*4)}Q${p(x+nx*w*.5,y+ny*w*.5)} ${p(x+tx*2,y+ty*2)}M${p(x-nx*w-tx*4,y-ny*w-ty*4)}Q${p(x-nx*w*.5,y-ny*w*.5)} ${p(x+tx*2,y+ty*2)}`;
  }).join('');
}
const tailEtching=[
  barbs([[190,174],[218,108],[270,88],[293,124]],30,5),
  barbs([[293,124],[306,146],[301,168],[295,188]],17,3),
  barbs([[193,184],[222,128],[270,103],[283,141]],26,5),
  barbs([[283,141],[291,154],[286,174],[280,186]],13,3),
  barbs([[198,193],[223,153],[259,135],[266,161]],23,5),
  barbs([[266,161],[273,180],[261,198],[252,206]],13,3),
  barbs([[202,202],[225,175],[246,163],[249,181]],17,4),
  barbs([[249,181],[252,196],[236,219],[225,225]],12,3),
];
