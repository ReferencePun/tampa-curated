---
import {radialMarks} from '../../lib/mechanisms';
import {sketchArc} from '../../lib/drafting';
interface Props {x:number;y:number;radius?:number;rate?:number;}
const {x,y,radius:r=42,rate=.4}=Astro.props;
---
<g transform={`translate(${x} ${y})`} class="compass-dial">
  <path d={sketchArc(r+7,3)} class="construction"/><path d={sketchArc(r,5)}/><path d={sketchArc(r-5,6)}/><path d={sketchArc(r+.9,7,.4,3.7)} class="sketch-retrace"/><path d={radialMarks(r-10,40,3)} class="hairline"/>
  <path d={`M${-r-13} 0H${r+13}M0 ${-r-13}V${r+13}`} class="construction"/>
  <g data-gear data-rate={rate} data-phase="-18" transform="rotate(-18)"><path d={`M0 ${-r+13}L4 0L0 ${r-13}L-4 0Z`} fill="var(--paper)"/><path d={`M0 ${-r+13}L4 0H-4Z`} fill="url(#tc-crosshatch)"/><circle r="3" fill="var(--paper)"/></g>
  <text y={-r-18} text-anchor="middle" class="diagram-label">N</text>
</g>
