---
import DraftingGuides from './DraftingGuides.astro';
import EngravedGear from './EngravedGear.astro';
import PulleySystem from './PulleySystem.astro';
import CrankAndPiston from './CrankAndPiston.astro';
import CompassDial from './CompassDial.astro';
import RotatingAperture from './RotatingAperture.astro';
import {meshPhase,radialMarks} from '../../lib/mechanisms';
import {url} from '../../lib/urls';
const smallPhase=meshPhase(60,26,180);
const upperPhase=meshPhase(60,20,-46);
---
<section class="clockwork-hero engraving-section" data-machine="hero" aria-labelledby="masthead">
  <div class="clockwork-hero-inner">
    <div class="clockwork-copy">
      <div class="hero-name">
      <span class="plate-label">TAMPA CURATED · THE CITY ISSUE</span>
      <h1 id="masthead">TAMPA<span>A CITY IN MOTION</span></h1>
      </div>
      <div class="hero-editorial">
      <p class="hero-intro">A place is more than its parts.<br/>Come see how ours fit together.</p>
      <p class="hero-deck">An independent eye on the people, places, and ideas that keep this city turning.</p>
      <a class="engraved-link" href={url('stories/the-city-now/')}>Explore the city <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-scroll"><span class="scroll-wheel" aria-hidden="true">↓</span><span>SCROLL TO SET THE CITY IN MOTION<br/><small>Slowly, if you like. There’s a lot to see.</small></span></div>
      <span class="hero-coordinate">27° 57′ N &nbsp; / &nbsp; 82° 27′ W</span>
    </div>
    <div class="hero-instrument">
      <svg class="engraving-svg hero-assembly" viewBox="0 0 800 680" role="img" aria-labelledby="hero-machine-title hero-machine-desc">
        <title id="hero-machine-title">The clockwork city</title><desc id="hero-machine-desc">An original engraved mechanism with meshing gears, a belt drive, and a connecting rod. A circular aperture reveals a photograph of Tampa’s waterfront. Scrolling operates the assembly.</desc>
        <DraftingGuides width={800} height={680}/>
        <g class="construction"><circle cx="440" cy="300" r="210"/><circle cx="440" cy="300" r="194" stroke-dasharray="3 7"/><path d="M35 300H778M440 37V615M116 78L740 576M172 588L697 70"/><path d="M52 600H750M65 593V607M740 593V607"/><path d={radialMarks(200,120,3)} transform="translate(440 300)"/></g>
        <g class="mobile-secondary"><path d="M199 300L440 300L595.6 138.9L699 465L428 534Z" fill="url(#tc-dots)" class="construction"/><path d="M130 473H267V502H130Z" fill="url(#tc-hatch)"/><circle cx="135" cy="488" r="3"/><circle cx="259" cy="488" r="3"/></g>
        <RotatingAperture id="hero" x={440} y={300} radius={128} photo="tampa-night" eager/>
        <EngravedGear x={440} y={300} radius={168} teeth={60} rate={1} design="ring"/>
        <EngravedGear x={199.2} y={300} radius={72.8} teeth={26} rate={-60/26} phase={smallPhase} design="spoked"/>
        <EngravedGear x={199.2} y={182.4} radius={44.8} teeth={16} rate={60/16} phase={meshPhase(26,16,-90,smallPhase)} design="disc" class="mobile-secondary"/>
        <EngravedGear x={595.6} y={138.9} radius={56} teeth={20} rate={-3} phase={upperPhase} design="spoked"/>
        <EngravedGear x={428} y={534.89} radius={67.2} teeth={24} rate={-2.5} phase={meshPhase(60,24,92.925)} design="disc" class="mobile-secondary"/>
        <PulleySystem x1={595.6} y1={138.9} r1={25} x2={699} y2={465} r2={34} rate={-3}/>
        <CrankAndPiston x={199.2} y={300} radius={26} rod={132} rate={-60/26} phase={smallPhase}/>
        <CrankAndPiston x={699} y={465} radius={16} rod={91} rate={-75/34} phase={0}/>
        <g class="mobile-secondary"><CompassDial x={83} y={130} radius={38}/><path data-drawing pathLength="1" d="M83 178V230H105M277 110H339L359 130M590 376H748V540H730M428 611V641H270" class="construction"/><path d="M60 615H150M60 620H120" class="hairline"/><text x="71" y="651" class="diagram-note">The city, considered.</text></g>
        <g class="diagram-annotations"><text x="353" y="80" class="diagram-label">FIG. 01 / THE CLOCKWORK CITY</text><text x="618" y="75" class="diagram-note">I. The drive</text><path d="M638 83L616 106"/><text x="62" y="370" class="diagram-note">II. The linkage</text><path d="M144 375L173 395"/><text x="561" y="579" class="diagram-note">III. In constant relation</text><path d="M580 560L661 499"/><text x="370" y="646" class="diagram-label">WATER · PEOPLE · POSSIBILITY</text></g>
      </svg>
      <span class="instrument-caption">PLATE I. &nbsp; AN INDEPENDENT VIEW OF TAMPA, FLORIDA.</span>
    </div>
  </div>
</section>
