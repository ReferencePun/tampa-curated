---
import { getImage } from 'astro:assets';
import { photos } from '../../lib/photos';
import { sketchArc, sketchLine } from '../../lib/drafting';
interface Props { id:string; photo:string; x:number;y:number;width:number;height:number;circle?:boolean;eager?:boolean; }
const {id,photo,x,y,width,height,circle=false}=Astro.props;
const image=await getImage({src:photos[photo],width:960,format:'webp',quality:82});
---
<g class="mechanical-image-frame">
  <defs><clipPath id={id}>{circle?<circle cx={x+width/2} cy={y+height/2} r={width/2}/>:<rect x={x} y={y} width={width} height={height}/>}</clipPath></defs>
  <image href={image.src} x={x} y={y} width={width} height={height} preserveAspectRatio="xMidYMid slice" clip-path={`url(#${id})`} class="engraved-photo"/>
  {circle?<g transform={`translate(${x+width/2} ${y+height/2})`}><path d={sketchArc(width/2+4,3)}/><path d={sketchArc(width/2+8,7)}/><path d={sketchArc(width/2+9,5,.3,4.3)} class="sketch-retrace"/></g>:<><path d={sketchLine(x-7,y-5,x+width+7,y-5,2)+sketchLine(x+width+5,y-7,x+width+5,y+height+7,4)+sketchLine(x+width+7,y+height+5,x-7,y+height+5,6)+sketchLine(x-5,y+height+7,x-5,y-7,8)}/><rect x={x-9} y={y-9} width={width+18} height={height+18} class="construction"/></>}
</g>
