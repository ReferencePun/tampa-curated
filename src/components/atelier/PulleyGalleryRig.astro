---
import HandwrittenNote from './HandwrittenNote.astro';
import DraftingGuides from './DraftingGuides.astro';
import PulleySystem from '../engraving/PulleySystem.astro';
import EngravedGear from './EngravedGear.astro';
---
<svg class="engraving-svg gallery-rig" viewBox="0 0 800 660" aria-hidden="true">
  <DraftingGuides width={800} height={660}/>
  <path d="M34 80H760M90 42V635M712 42V635M70 628H735" class="construction"/>
  <path d="M48 85H750M48 89H750"/>
  <path d="M66 60H148V110H66ZM629 60H711V110H629Z" fill="url(#tc-hatch)"/>
  <PulleySystem x1={107} y1={85} r1={48} x2={670} y2={85} r2={48} rate={-1} crossed/>
  <EngravedGear x={107} y={85} radius={29} teeth={24} rate={-1} design="spoked"/>
  <path data-weight-cable="59" d="M59 85V480" class="hairline"/><path data-weight-cable="718" d="M718 85V480" class="hairline"/>
  <path data-lift-cable="left" d="M155 85V192H160"/><path data-lift-cable="right" d="M622 85V192H640"/>
  <g data-counterweight="40" transform="translate(40 480)"><rect width="38" height="75" fill="url(#tc-hatch)"/><path d="M4 5H34M4 10H34M4 65H34M4 70H34"/><circle cx="19" cy="36" r="9"/><text x="19" y="39" text-anchor="middle" class="diagram-label">W</text></g>
  <g data-counterweight="699" transform="translate(699 480)"><rect width="38" height="75" fill="url(#tc-hatch)"/><path d="M4 5H34M4 10H34M4 65H34M4 70H34"/><circle cx="19" cy="36" r="9"/></g>
  <path d="M751 150V570M744 155H758M744 565H758" class="construction"/>
  {Array.from({length:32},(_,i)=><path d={`M746 ${160+i*13}h${i%5?6:12}`} class="hairline"/>)}
  <HandwrittenNote text="held in suspension" x={227} y={42} rotate={-3} scale={1.3}/><path d="M42 93L754 91M69 62L65 109L150 112M630 61L626 112L710 113" class="pencil-line"/><path data-drawing pathLength="1" d="M30 225Q-2 306 23 388L19 375M23 388L29 374" class="red-pencil"/>
</svg>
