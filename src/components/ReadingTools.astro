<aside class="reading-tools" data-reading-tools aria-label="Reading preferences" hidden>
  <div class="reading-panel" id="reading-panel" hidden>
    <div class="reading-panel-heading"><h2>Make yourself comfortable.</h2><button type="button" data-reading-close aria-label="Close reading preferences">×</button></div>
    <fieldset>
      <legend>Text size</legend>
      <div class="reading-size-options">
        <label><input type="radio" name="reading-size" value="comfortable" checked/><span>Comfortable</span></label>
        <label><input type="radio" name="reading-size" value="original"/><span>Original</span></label>
      </div>
    </fieldset>
    <p class="reading-size-help">Larger type, with room to read. Or revisit the original magazine scale.</p>
    <div class="reading-lens-option"><span id="reading-lens-label">Sea glass</span><button type="button" data-reading-lens aria-labelledby="reading-lens-label reading-lens-state" aria-pressed="false"><span id="reading-lens-state">Off</span></button></div>
    <p data-reading-lens-help>Move the sea glass across the page to bend and gently magnify everything underneath. Links still work. Press Esc to put it away.</p>
  </div>
  <button class="reading-launcher" type="button" aria-expanded="false" aria-controls="reading-panel"><span aria-hidden="true">Aa</span> Reading <span class="reading-lens-indicator" hidden>· Glass on</span></button>
  <span class="sr-only" role="status" aria-live="polite" data-reading-status></span>
</aside>
<div class="sea-glass-viewport" aria-hidden="true" inert><div class="reading-lens" data-text-lens aria-hidden="true" inert hidden>
  <svg class="sea-glass-surface" viewBox="0 0 320 280" fill="none">
    <defs>
      <linearGradient id="sea-glass-tint" x1="40" y1="18" x2="260" y2="260" gradientUnits="userSpaceOnUse"><stop stop-color="#d5f5df" stop-opacity=".15"/><stop offset=".4" stop-color="#6cbdac" stop-opacity=".045"/><stop offset="1" stop-color="#298575" stop-opacity=".19"/></linearGradient>
      <linearGradient id="sea-glass-rim" x1="70" y1="22" x2="240" y2="260" gradientUnits="userSpaceOnUse"><stop stop-color="#f0fff3" stop-opacity=".8"/><stop offset=".3" stop-color="#bddccc" stop-opacity=".5"/><stop offset=".6" stop-color="#4c9284" stop-opacity=".25"/><stop offset="1" stop-color="#27665b" stop-opacity=".6"/></linearGradient>
      <radialGradient id="sea-glass-light" cx=".25" cy=".15" r=".85"><stop stop-color="#f3fff3" stop-opacity=".22"/><stop offset=".55" stop-color="#f3fff3" stop-opacity="0"/></radialGradient>
    </defs>
    <path data-glass-outline id="sea-glass-outline" d="M74 18 C120 4 200 29 251 58 C280 75 292 91 279 125 L221 244 C210 268 186 277 162 263 L43 203 C19 191 14 169 24 137 L49 46 C54 29 61 22 74 18Z" fill="url(#sea-glass-tint)" stroke="url(#sea-glass-rim)" stroke-width="3"/>
    <use href="#sea-glass-outline" fill="url(#sea-glass-light)" stroke="none"/>
    <path d="M59 47 Q67 27 83 26 C126 16 196 40 239 62" stroke="#f2fff1" stroke-opacity=".5" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M220 234 Q202 271 175 258 L49 196" stroke="#247566" stroke-opacity=".25" stroke-width="3" stroke-linecap="round"/>
  </svg>
</div></div>
<script>
  import '../scripts/reading-tools';
</script>
