---
import { motion } from '../scripts/mechanical/settings';
---
<!-- Blocking registration is required for the native pagereveal event. Normal
     anchors, document navigation, focus, and browser history remain native. -->
<script is:inline define:vars={{ duration: motion.transitionMs }}>
  (() => {
    const html = document.documentElement;
    try { html.dataset.motion = localStorage.getItem('tc-motion') === 'reduced' ? 'reduced' : 'system'; } catch { html.dataset.motion = 'system'; }
    html.style.setProperty('--image-transition-duration', duration + 'ms');
    if (!('onpageswap' in window) || !('onpagereveal' in window)) return;
    const reduced = () => html.dataset.motion === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clear = () => document.querySelectorAll('[data-transition-active]').forEach(el => { el.style.removeProperty('view-transition-name'); delete el.dataset.transitionActive; });
    const read = () => { try { return JSON.parse(sessionStorage.getItem('tc-image-transition') || 'null'); } catch { return null; } };
    const findImage = key => {
      const selector = CSS.escape(key);
      const wrapper = document.querySelector(`[data-shared-image="${selector}"]`) || document.querySelector(`[data-image-link="${selector}"] .photo`);
      return wrapper && wrapper.getClientRects().length ? wrapper : null;
    };
    const name = el => { clear(); el.style.viewTransitionName = 'tc-editorial-image'; el.dataset.transitionActive = ''; };
    document.addEventListener('click', event => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || reduced()) return;
      const link = event.target.closest('a[data-shared-link], a[data-image-link]');
      if (!link || link.target || link.hasAttribute('download')) return;
      const to = new URL(link.href);
      if (to.origin !== location.origin || to.hash || to.pathname === location.pathname) return;
      const key = link.dataset.sharedLink || link.dataset.imageLink;
      const image = findImage(key);
      if (!image) return;
      try { sessionStorage.setItem('tc-image-transition', JSON.stringify({ key, from: location.pathname, to: to.pathname, time: Date.now() })); } catch { return; }
      name(image);
    });
    window.addEventListener('pageswap', event => {
      if (!event.viewTransition) return;
      // Native navigation can cancel a transition when motion is disabled.
      event.viewTransition.ready.catch(() => {});
      const record = read();
      const destination = event.activation?.entry?.url;
      const path = destination ? new URL(destination).pathname : '';
      const paired = record && Date.now() - record.time < 900000 && ((location.pathname === record.from && path === record.to) || (location.pathname === record.to && path === record.from));
      const image = paired && findImage(record.key);
      if (reduced() || !image) { clear(); event.viewTransition.skipTransition(); return; }
      name(image);
      event.viewTransition.finished.finally(clear).catch(() => {});
    });
    window.addEventListener('pagereveal', event => {
      if (!event.viewTransition) { clear(); return; }
      event.viewTransition.ready.catch(() => {});
      const record = read();
      const source = event.activation?.from?.url;
      const paired = record && Date.now() - record.time < 900000 && (location.pathname === record.to || location.pathname === record.from);
      const image = paired && findImage(record.key);
      if (reduced() || !image || (source && new URL(source).pathname === location.pathname)) { clear(); event.viewTransition.skipTransition(); return; }
      name(image);
      event.viewTransition.finished.finally(clear).catch(() => {});
    });
  })();
</script>
<style is:global>
  @view-transition { navigation: auto; }
  :root { view-transition-name: none; }
  ::view-transition-group(tc-editorial-image) { animation-duration: var(--image-transition-duration, 420ms); animation-timing-function: cubic-bezier(.22,.61,.36,1); }
  ::view-transition-old(tc-editorial-image), ::view-transition-new(tc-editorial-image) { height:100%; object-fit:cover; animation-duration:var(--image-transition-duration,420ms); }
  ::view-transition { pointer-events:none; }
  @media(prefers-reduced-motion:reduce) { @view-transition { navigation: none; } }
  html[data-motion=reduced]::view-transition-group(*) { animation-duration:0s; }
</style>
