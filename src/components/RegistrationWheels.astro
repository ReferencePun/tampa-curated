---
interface Props { single?: boolean; }
const { single = false } = Astro.props;
---
<svg class:list={['registration-wheels', { single }]} viewBox={single ? '0 0 112 112' : '0 0 215 125'} fill="none" aria-hidden="true">
  <path d={single ? 'M0 56H112M56 0V112' : 'M0 60H215M60 0V125M160 0V125'} stroke="currentColor" stroke-width=".5"/>
  <g class="wheel wheel-a" style={single ? 'transform-origin:56px 56px' : 'transform-origin:60px 60px'}>
    <circle cx={single ? 56 : 60} cy={single ? 56 : 60} r="48" stroke="currentColor"/>
    <circle cx={single ? 56 : 60} cy={single ? 56 : 60} r="39" stroke="currentColor" stroke-dasharray="1 9.21" stroke-width="5"/>
    <circle cx={single ? 56 : 60} cy={single ? 56 : 60} r="25" stroke="currentColor" stroke-width=".5"/>
    <path d={single ? 'M56 8V31M56 81V104M8 56H31M81 56H104' : 'M60 12V35M60 85V108M12 60H35M85 60H108'} stroke="currentColor"/>
    <circle cx={single ? 70 : 74} cy={single ? 42 : 46} r="3" fill="currentColor"/>
  </g>
  {!single && <g transform="translate(-20 0)"><g class="wheel wheel-b" style="transform-origin:160px 60px">
    <circle cx="160" cy="60" r="32" stroke="currentColor"/>
    <circle cx="160" cy="60" r="25" stroke="currentColor" stroke-dasharray="1 8.82" stroke-width="5"/>
    <path d="M160 28V92M128 60H192" stroke="currentColor"/>
    <circle cx="160" cy="60" r="8" stroke="currentColor"/>
  </g></g>}
</svg>
