---
import { url } from '../lib/urls';
const groups = [
  {label:'THE HOMEPAGES', links:[
    ['Home 1', 'The editorial edition', ''],
    ['Home 2', 'The clockwork city', 'home2/'],
    ['Home 3', 'The expressive notebook', 'home3/'],
  ]},
  {label:'THE EXPERIMENTS', links:[
    ['The Impossible Lab', 'Reusable inventions & study plates', 'lab/'],
    ['Particle archive', 'Photographs in living ink', 'stories/'],
    ['The unfinished city', 'Walk through the drawing', 'unfinished-city/'],
    ['Cabinet of curiosities', 'Six drawers to discover', 'experiments/cabinet/'],
    ['The tracing table', 'Ink, film, and the archive', 'experiments/tracing-city/'],
    ['Your field notebook', 'Collect, arrange, and write', 'experiments/notebook/'],
  ]},
];
const selected=(path:string)=>Astro.url.pathname.replace(/\/$/,'')===url(path).replace(/\/$/,'');
---
<details class="concept-navigation" data-concept-navigation>
  <summary>Concepts <svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></summary>
  <nav class="concept-panel" aria-label="Concept pages">
    <div class="concept-panel-heading"><span>TAMPA, FROM A FEW ANGLES.</span><span aria-hidden="true">↗</span></div>
    <div class="concept-groups">
      {groups.map(group=><div class="concept-group"><span class="concept-group-label">{group.label}</span>{group.links.map(([title,description,path])=><a href={url(path)} aria-current={selected(path)?'page':undefined}><strong>{title}</strong><span>{description}</span><i aria-hidden="true">↗</i></a>)}</div>)}
    </div>
    <a class="concept-overview" href={url('experiments/')} aria-current={selected('experiments/')?'page':undefined}>All experiments <span aria-hidden="true">⟶</span></a>
  </nav>
</details>
<style>
  .concept-navigation {flex:none;margin-left:auto;}
  summary {list-style:none;display:flex;align-items:center;gap:10px;min-height:44px;cursor:pointer;font:600 var(--reading-small,1rem)/1.4 var(--condensed);text-transform:uppercase;letter-spacing:.04em;}
  summary::-webkit-details-marker {display:none;}
  summary svg {transition:transform .18s ease;flex-shrink:0;}
  [open] summary {color:var(--red);}
  [open] summary svg {transform:rotate(180deg);}
  .concept-panel {position:absolute;z-index:12;top:calc(100% - 1px);right:0;width:min(650px,100%);max-height:min(76svh,760px);overflow:auto;overscroll-behavior:contain;padding:24px 28px 18px;background:var(--paper-light);border:1px solid var(--rule);border-top:2px solid var(--ink);box-shadow:0 14px 24px #1717141c;}
  .concept-panel-heading {display:flex;justify-content:space-between;gap:20px;font:600 var(--reading-small,1rem)/1.5 var(--condensed);letter-spacing:.08em;padding-bottom:20px;color:var(--muted);}
  .concept-groups {display:grid;grid-template-columns:1fr 1.2fr;gap:28px;}
  .concept-group {min-width:0;}
  .concept-group-label {display:block;border-bottom:1px solid var(--rule);padding-bottom:10px;margin-bottom:6px;color:var(--muted);font:600 var(--reading-small,1rem)/1.5 var(--condensed);letter-spacing:.06em;}
  .concept-group a {display:grid;grid-template-columns:1fr 16px;gap:3px 8px;padding:12px 8px 12px 0;border-bottom:1px solid color-mix(in srgb,var(--rule) 28%,transparent);transition:color .18s ease,background-color .18s ease;}
  .concept-group a strong {font:400 1.125rem/1.4 var(--serif);}
  .concept-group a>span {font:500 var(--reading-small,1rem)/1.4 var(--condensed);color:var(--muted);grid-column:1;}
  .concept-group a i {grid-column:2;grid-row:1;font-style:normal;}
  .concept-group a[aria-current] {color:var(--red);}
  .concept-group a[aria-current] strong {text-decoration:underline;text-underline-offset:5px;}
  .concept-group a:is(:hover,:focus-visible) {color:var(--red);background:color-mix(in srgb,var(--red) 5%,transparent);}
  .concept-overview {display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:48px;margin-top:18px;font:600 var(--reading-small,1rem)/1.5 var(--condensed);border-top:1px solid var(--rule);padding-top:10px;}
  .concept-overview[aria-current] {color:var(--red);}
  summary:focus-visible,a:focus-visible {outline:2px solid var(--red);outline-offset:4px;}
  @media(max-width:600px){
    summary {gap:7px;letter-spacing:0;}
    .concept-panel {padding:18px;max-height:72svh;}
    .concept-panel-heading {padding-bottom:14px;}
    .concept-groups {grid-template-columns:1fr;gap:22px;}
    .concept-group a {padding-block:10px;}
  }
  @media(prefers-reduced-motion:reduce){summary svg,a {transition:none!important;}}
  @media print{.concept-navigation {display:none;}}
</style>
